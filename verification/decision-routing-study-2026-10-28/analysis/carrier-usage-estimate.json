{
  "assumptions": {
    "phase_proof": "locked/E2-lock.json confirms all four E2 submissions before estimation",
    "unit": "One request is one inference invocation; tool calls may induce multiple invocations per agent turn. All estimates hypothetical, not telemetry.",
    "scope": "Incremental phase work consolidated by stable ID; ranges assume initial dispatched work meaningfully progresses before developments; overlap/interruption may reduce it. Two-hour horizon plus developments is ambiguous and does not guarantee completion. Future code/campaign operations require authorization.",
    "request_method": "Low/high counts manually estimated per phase from reads, tool cycles, discriminator design, synthesis, review and bounded repair; future execution ranges include normal retry/repair capacity, not automatic repair. Zero increment on a deferred phase means scope refinement only, not an extra full restart.",
    "source_method": "Union of H excerpts from the assignment across phases. Low source payload = 0.20 tokens/byte; high = 0.75 tokens/byte (0.50 tokens/byte times 1.5 for repeated reads). Bytes are a rough proxy, not tokenization; development summaries/history are included in request-history allowance.",
    "input_formula": "input_low = 16000*requests_low + ceil(0.20*source_bytes) + 700*requests_low; input_high = 48000*requests_high + ceil(0.75*source_bytes) + 2200*requests_high. Source and history components count included/repeated tool results, prior responses and handoffs. For unmeasured overhead C use input = C*requests + payload_history.",
    "cache_formula": "Low endpoint cached input = floor(0.8*16000*(requests_low-new_conversations)); first request per new conversation cold, reused conversations start eligible. High endpoint all cold. Cached input is a subset of input; source/history is conservatively cold.",
    "output_formula": "Low output = 450*requests_low; high output = 1400*requests_high. Output includes unknown reasoning and deliverable tokens; actual effort and hidden reasoning can fall outside this illustrative range.",
    "unmeasured_context": "C=16k\u201348k per request is an uncalibrated shared-instruction/tool-context sensitivity, not a floor or guarantee. An extra full policy is about 85 KB/11.5k words and role/tool harness may place actual context outside this range; use variable C above.",
    "price": "User-supplied pricing verified 2026-10-28, Standard short context API USD per million input/cached/output tokens: Luna 0.10/0.01/0.50, Terra 1/0.05/5, Sol 2/0.10/10, Astra 10/1/50. Comparison only; actual settings unchanged.",
    "usd_formula": "((input-cached)*input_rate + cached*cached_rate + output*output_rate)/1000000; no-cache low replaces cached with zero; high is already cold.",
    "subscription": "No token-to-week conversion: Terra=1, Sol approximately 10, Astra approximately 20 are user-reported relative weekly indices; Luna unknown. None calibrates this work or API dollars.",
    "classification": "Base includes planned read-only work and continuations now/queued, including E2-triggered Astra; reserve is individually conditional on future authorization and evidence. Reserve totals are scenarios if all those rows execute, not a prediction that they will."
  },
