+"""Repeat the complete post-preparation stream search for every current case."""
+import argparse
+import os
+from pathlib import Path
+import time
+import tracemalloc
+
+from receiver import load_cases, prepare, receive, synthesize
+
+
+def effective_cpus():
+    """An upper bound, not a measurement of parallel receiver scaling."""
+    cpus = float(len(os.sched_getaffinity(0))) if hasattr(os, 'sched_getaffinity') else float(os.cpu_count() or 1)
+    try:
+        quota, period = Path('/sys/fs/cgroup/cpu.max').read_text().split()
+        if quota != 'max':
+            cpus = min(cpus, int(quota) / int(period))
+    except (OSError, ValueError):
+        pass
+    return cpus
+
+
+def memory_headroom():
+    """Approximate currently available shared memory; not a reservation."""
+    bounds = []
+    try:
+        lines = Path('/proc/meminfo').read_text().splitlines()
+        bounds.append(next(int(line.split()[1]) * 1024 for line in lines if line.startswith('MemAvailable:')))
+    except (OSError, StopIteration, ValueError):
+        pass
+    try:
+        maximum = Path('/sys/fs/cgroup/memory.max').read_text().strip()
+        current = int(Path('/sys/fs/cgroup/memory.current').read_text().strip())
+        if maximum != 'max':
+            bounds.append(max(0, int(maximum) - current))
+    except (OSError, ValueError):
+        pass
+    return min(bounds) if bounds else None
+
+
+def run_case(case, seconds, cpus, available):
+    # Generation and data-independent oscillator tables are outside timing.
+    samples = synthesize(case)
+    tracemalloc.start()
+    tables = prepare(case['sample_rate'], len(samples))
+    prepared, _ = tracemalloc.get_traced_memory()
+    tracemalloc.reset_peak()
+    result = receive(samples, case['sample_rate'], case['symbol_samples'], len(case['bits']), tables)
+    _, peak = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+    # Warm-up above also confirms actual processing before the measurement.
+    wall_start = time.perf_counter()
+    cpu_start = time.process_time()
+    count = 0
+    while True:
+        result = receive(samples, case['sample_rate'], case['symbol_samples'], len(case['bits']), tables)
+        count += 1
+        if time.perf_counter() - wall_start >= seconds:
+            break
+    wall = time.perf_counter() - wall_start
+    cpu = time.process_time() - cpu_start
+    input_seconds = count * len(samples) / case['sample_rate']
+    wall_ratio = wall / input_seconds
+    cpu_ratio = cpu / input_seconds
+    bits, start, offset = result
+    correct = sum(a == b for a, b in zip(bits, case['bits']))
+    print(f"{case['name']}: recovered {bits} / {case['bits']} ({correct}/{len(case['bits'])} bits); "
+          f"start {start} / {case['leading_samples']}; offset {offset:+g} / {case['offset_hz']:+g} Hz")
+    print(f"  {count} streams, {input_seconds:.3f} input s; wall {wall_ratio:.5f} s/input s, "
+          f"real-time margin {1 / wall_ratio:.1f}x; CPU {cpu_ratio:.5f} s/input s")
+    print(f"  estimated CPU-only ceiling {1 / cpu_ratio:.1f} streams/core, "
+          f"{cpus / cpu_ratio:.1f} streams at {cpus:g} available CPU(s), assuming linear scaling")
+    print(f"  traced Python allocation: prepared {prepared / 1048576:.2f} MiB, "
+          f"processing peak +{(peak - prepared) / 1048576:.2f} MiB (excludes samples/interpreter)")
+    if available is not None and peak:
+        print(f"  allocation-only headroom: {available / peak:.0f} independent workspaces; "
+              f"at CPU-only ceiling allocations use {100 * (cpus / cpu_ratio) * peak / available:.1f}% of headroom")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--seconds', type=float, default=0.75,
+                        help='minimum measured wall seconds per case (default: 0.75)')
+    args = parser.parse_args()
+    if args.seconds <= 0:
+        parser.error('--seconds must be positive')
+    cpus = effective_cpus()
+    available = memory_headroom()
+    print(f'Effective CPU upper bound: {cpus:g}; approximate shared memory headroom: ' +
+          (f'{available / 1048576:.0f} MiB' if available is not None else 'unknown'))
+    for case in load_cases():
+        run_case(case, args.seconds, cpus, available)
+
+
+if __name__ == '__main__':
+    main()
