+def prepare(sample_rate, length, offsets=range(-10, 11)):
+    """Reusable oscillators; independent of received data and case truth."""
+    tables = []
+    for offset in offsets:
+        tones = []
+        for tone in TONES:
+            step = 2 * math.pi * (tone + offset) / sample_rate
+            tones.append([(math.cos(step * i), math.sin(step * i)) for i in range(length)])
+        tables.append((offset, tones))
+    return tables
+
+
+def receive(samples, sample_rate, symbol_samples, bit_count, tables):
+    """Search all feasible starts and prepared offsets, maximizing tone energy.
+
+    The duration and number of symbols are supplied, not their start, bits, or
+    offset. Prefix sums avoid recomputing a correlation for every candidate.
+    """
+    n = symbol_samples
+    last = len(samples) - n * bit_count
+    if last < 0 or not bit_count:
+        raise ValueError('stream is too short or has no symbols')
+    best_score = float('-inf')
+    best = None
+    for offset, tones in tables:
+        powers = []
+        for oscillator in tones:
+            if len(oscillator) < len(samples):
+                raise ValueError('prepared oscillator is too short')
+            re = [0.0]
+            im = [0.0]
+            r = q = 0.0
+            for x, (cosine, sine) in zip(samples, oscillator):
+                r += x * cosine
+                q += x * sine
+                re.append(r)
+                im.append(q)
+            powers.append((re, im))
+        for start in range(last + 1):
+            score = 0.0
+            decisions = []
+            for k in range(bit_count):
+                a = start + k * n
+                b = a + n
+                energies = []
+                for re, im in powers:
+                    dr, di = re[b] - re[a], im[b] - im[a]
+                    energies.append(dr * dr + di * di)
+                bit = int(energies[1] > energies[0])
+                decisions.append(str(bit))
+                score += energies[bit]
+            if score > best_score:
+                best_score = score
+                best = (''.join(decisions), start, offset)
+    if best is None:
+        raise ValueError('no frequency candidates')
+    return best
+
+
