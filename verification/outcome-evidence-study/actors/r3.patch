+def prepare(sample_rate, sample_count, symbol_samples, bit_count, offsets=OFFSETS_HZ):
+    """Precompute sample-independent oscillators for a fixed observation shape."""
+    if symbol_samples <= 0 or bit_count <= 0 or sample_count < symbol_samples * bit_count:
+        raise ValueError('observation must contain at least one complete message')
+    if not offsets:
+        raise ValueError('at least one offset is required')
+    waves = []
+    for offset in offsets:
+        pair = []
+        for tone in TONES:
+            angles = (2 * math.pi * (tone + offset) * i / sample_rate
+                      for i in range(sample_count))
+            pair.append([(math.cos(a), math.sin(a)) for a in angles])
+        waves.append((offset, pair))
+    return (sample_count, symbol_samples, bit_count, waves)
+
+
+def receive(samples, prepared):
+    """Search every feasible sample start and supplied offset, then decide bits.
+
+    Only message length and symbol size are known. No start, offset, or bit truth
+    is passed to the receiver. This always returns a best candidate, even on noise.
+    """
+    count, n, bit_count, waves = prepared
+    if len(samples) != count:
+        raise ValueError('sample count differs from prepared observation')
+    best_score = -1.0
+    best = None
+    for offset, pair in waves:
+        prefixes = []
+        for wave in pair:
+            re, im = [0.0], [0.0]
+            r = q = 0.0
+            for sample, (cosine, sine) in zip(samples, wave):
+                r += sample * cosine
+                q += sample * sine
+                re.append(r)
+                im.append(q)
+            prefixes.append((re, im))
+        for start in range(count - n * bit_count + 1):
+            score = 0.0
+            decisions = []
+            for k in range(bit_count):
+                a = start + k * n
+                b = a + n
+                values = []
+                for re, im in prefixes:
+                    values.append((re[b] - re[a]) ** 2 + (im[b] - im[a]) ** 2)
+                bit = int(values[1] > values[0])
+                decisions.append(str(bit))
+                score += values[bit]
+            if score > best_score:
+                best_score = score
+                best = (''.join(decisions), start, offset)
+    return best
+
+
+def available_memory():
+    """Linux available memory, if reported; this is not a reservation or limit."""
+    try:
+        for line in Path('/proc/meminfo').read_text().splitlines():
+            if line.startswith('MemAvailable:'):
+                return int(line.split()[1]) * 1024
+    except OSError:
+        pass
+    return None
+
+
+def benchmark(case, minimum_seconds=0.5):
+    """Measure repeated complete processing with preparation outside the timer."""
+    samples = synthesize(case)
+    n, length, sr = case['symbol_samples'], len(case['bits']), case['sample_rate']
+    tracemalloc.start()
+    prepared = prepare(sr, len(samples), n, length)
+    prepared_bytes, _ = tracemalloc.get_traced_memory()
+    tracemalloc.reset_peak()
+    result = receive(samples, prepared)
+    _, peak = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+    working_bytes = peak - prepared_bytes
+    # Existing input is allocated before tracing, so include its Python footprint.
+    input_bytes = sys.getsizeof(samples) + sum(sys.getsizeof(x) for x in samples)
+    runs = 0
+    wall_start, cpu_start = time.perf_counter(), time.process_time()
+    while True:
+        result = receive(samples, prepared)
+        runs += 1
+        wall = time.perf_counter() - wall_start
+        if wall >= minimum_seconds:
+            break
+    cpu = time.process_time() - cpu_start
+    input_seconds = runs * len(samples) / sr
+    return {'result': result, 'runs': runs, 'wall': wall, 'cpu': cpu,
+            'input_seconds': input_seconds, 'prepared_bytes': prepared_bytes,
+            'working_bytes': working_bytes, 'input_bytes': input_bytes,
+            'available_bytes': available_memory()}
+
+
+def report(case):
+    measurement = benchmark(case)
+    bits, start, offset = measurement['result']
+    wall_ratio = measurement['wall'] / measurement['input_seconds']
+    cpu_ratio = measurement['cpu'] / measurement['input_seconds']
+    total_bytes = sum(measurement[key] for key in ('input_bytes', 'prepared_bytes', 'working_bytes'))
+    print(f"{case['name']}: bits {bits}/{case['bits']} "
+          f"({'PASS' if bits == case['bits'] else 'FAIL'}), "
+          f"start {start}/{case['leading_samples']}, offset {offset}/{case['offset_hz']} Hz")
+    print(f"  {measurement['runs']} runs, {measurement['input_seconds']:.2f} input s, "
+          f"{measurement['wall']:.3f} wall s, {measurement['cpu']:.3f} CPU s")
+    print(f"  wall {wall_ratio:.5f} processing s/input s; "
+          f"real-time capacity {1 / wall_ratio:.1f}x, slack {(1 - wall_ratio) * 100:.1f}%")
+    print(f"  CPU {cpu_ratio:.5f} CPU s/input s; estimated one-core ceiling {1 / cpu_ratio:.1f}x")
+    print(f"  Python input {measurement['input_bytes'] / 1024:.1f} KiB, "
+          f"prepared {measurement['prepared_bytes'] / 1024:.1f} KiB, "
+          f"incremental peak workspace {measurement['working_bytes'] / 1024:.1f} KiB, "
+          f"total {total_bytes / 1024:.1f} KiB")
+    if measurement['available_bytes'] is not None:
+        print(f"  system available memory {measurement['available_bytes'] / 1024**2:.1f} MiB; "
+              f"estimated remaining {max(0, measurement['available_bytes'] - total_bytes) / 1024**2:.1f} MiB")
+
+
 if __name__ == '__main__':
