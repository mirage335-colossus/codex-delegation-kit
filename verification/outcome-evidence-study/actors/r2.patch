+def prepare_receiver(sample_rate, symbol_samples, bit_count, sample_count,
+                     offsets=range(-8, 9)):
+    """Build reusable frequency references for a fixed observation shape.
+
+    The receiver searches integer-Hz offsets in the supplied iterable. Neither
+    the arrival time, true frequency offset, nor the transmitted bits are used.
+    """
+    if symbol_samples <= 0 or bit_count <= 0 or sample_count < symbol_samples * bit_count:
+        raise ValueError('observation must contain at least one complete message')
+    references = []
+    for offset in offsets:
+        tones = []
+        for tone in TONES:
+            tones.append([complex(math.cos(2 * math.pi * (tone + offset) * i / sample_rate),
+                                  math.sin(2 * math.pi * (tone + offset) * i / sample_rate))
+                          for i in range(sample_count)])
+        references.append((offset, tones))
+    if not references:
+        raise ValueError('at least one frequency offset is required')
+    return (symbol_samples, bit_count, sample_count, references)
+
+
+def receive(samples, plan):
+    """Search all feasible message starts and frequency candidates, then decide bits.
+
+    The known message length and symbol duration delimit this abbreviated search.
+    Returns the best start, frequency-grid offset and recovered bits.
+    """
+    n, bit_count, sample_count, references = plan
+    if len(samples) != sample_count:
+        raise ValueError('samples must match the prepared observation length')
+    best_score = float('-inf')
+    best = None
+    for offset, tones in references:
+        energy_by_tone = []
+        for reference in tones:
+            weighted = [sample * phase for sample, phase in zip(samples, reference)]
+            correlation = sum(weighted[:n])
+            energies = [abs(correlation) ** 2]
+            for i in range(n, sample_count):
+                correlation += weighted[i] - weighted[i - n]
+                energies.append(abs(correlation) ** 2)
+            energy_by_tone.append(energies)
+        low, high = energy_by_tone
+        for start in range(sample_count - n * bit_count + 1):
+            score = sum(max(low[start + k*n], high[start + k*n]) for k in range(bit_count))
+            if score > best_score:
+                best_score = score
+                bits = ''.join(str(int(high[start + k*n] > low[start + k*n]))
+                               for k in range(bit_count))
+                best = (start, offset, bits)
+    return best
