+"""Short end-to-end processing and Python allocation measurement on local cases."""
+import argparse
+import os
+import platform
+import time
+import tracemalloc
+from pathlib import Path
+from receiver import load_cases, prepare_receiver, receive, synthesize
+
+
+def memory_budget():
+    """Snapshot available physical memory and, if applicable, cgroup headroom."""
+    available = os.sysconf('SC_AVPHYS_PAGES') * os.sysconf('SC_PAGE_SIZE')
+    limits = [('physical available', available)]
+    try:
+        root = Path('/sys/fs/cgroup')
+        maximum = (root / 'memory.max').read_text().strip()
+        if maximum != 'max':
+            limits.append(('cgroup headroom', max(0, int(maximum) - int((root / 'memory.current').read_text()))))
+    except (OSError, ValueError):
+        pass
+    return min(limits, key=lambda pair: pair[1])
+
+
+def benchmark(case, seconds):
+    budget_kind, budget = memory_budget()
+    tracemalloc.start()
+    samples = synthesize(case)
+    plan = prepare_receiver(case['sample_rate'], case['symbol_samples'],
+                            len(case['bits']), len(samples))
+    prepared, _ = tracemalloc.get_traced_memory()
+    tracemalloc.reset_peak()
+    start, offset, bits = receive(samples, plan)
+    _, peak = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+    # Warmed processing only: no generation, preparation, or allocation tracing.
+    receive(samples, plan)
+    elapsed = 0.0
+    iterations = 0
+    while elapsed < seconds:
+        begin = time.perf_counter()
+        receive(samples, plan)
+        elapsed += time.perf_counter() - begin
+        iterations += 1
+    duration = len(samples) / case['sample_rate']
+    ratio = elapsed / (iterations * duration)
+    print(f"{case['name']}: recovered {bits == case['bits']} ({bits}/{case['bits']}), "
+          f"start {start} (true {case['leading_samples']}), offset {offset} Hz "
+          f"(true {case['offset_hz']} Hz)")
+    print(f'  {iterations} runs, {elapsed:.3f} s processing / {iterations * duration:.3f} s input; '
+          f'{ratio:.6f} processing s/input s; real-time margin {(1-ratio)*100:.1f}%; '
+          f'serial CPU ceiling {1/ratio:.1f} input s/wall s')
+    print(f'  traced prepared {prepared/1048576:.2f} MiB; total traced processing peak '
+          f'{peak/1048576:.2f} MiB; {budget_kind} before preparation {budget/1048576:.0f} MiB; '
+          f'rough workspace multiples {budget/peak:.0f}x')
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--seconds', type=float, default=0.5,
+                        help='minimum timed processing seconds per case')
+    args = parser.parse_args()
+    if args.seconds <= 0:
+        parser.error('--seconds must be positive')
+    print(f'{platform.platform()}; Python {platform.python_version()}; '
+          f'visible CPUs {len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else os.cpu_count()}')
+    cases = load_cases()
+    if not cases:
+        parser.error('cases.json must contain at least one case')
+    for case in cases:
+        benchmark(case, args.seconds)
+
+
+if __name__ == '__main__':
+    main()
