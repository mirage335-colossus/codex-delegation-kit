+"""Read the current manually maintained Robust case list for abbreviated reports.
+
+The inventory and link-budget arithmetic are not simulations or receiver tests.
+"""
+from __future__ import annotations
+
+import hashlib
+import math
+from pathlib import Path
+import re
+
+DEFAULT_LIST = Path(__file__).resolve().parents[1] / '_tests-RobustModem.md'
+FIELDS = frozenset(('Encryption', 'Helper Carrier Transmit Power', 'Transmit Power',
+    'Path loss', 'Clock sync / Region / Offset / Audio error', 'Base Oscillator',
+    'Shift Oscillator', 'Doppler/delay spread',
+    'Additional frequency selective amplitude modulation', 'Margin', 'DSSS',
+    'Spreading', 'FHSS', 'Symbol_burst', 'Rate', 'Shift'))
+
+
+def parse_list(data):
+    cases = []
+    case = None
+    for line_number, line in enumerate(data.splitlines(), 1):
+        line = line.strip()
+        if not line:
+            continue
+        if line.startswith('- '):
+            if case is not None:
+                cases.append(case)
+            case = {'name': line[2:].strip(), 'fields': {}}
+            if not case['name']:
+                raise ValueError(f'line {line_number}: empty case name')
+            continue
+        if case is None or '\t' not in line:
+            raise ValueError(f'line {line_number}: expected a case heading or tab-separated field')
+        value, field = (part.strip() for part in line.split('\t', 1))
+        if not value or field not in FIELDS or field in case['fields']:
+            raise ValueError(f'line {line_number}: empty value, unknown or duplicate field: {field}')
+        case['fields'][field] = value
+    if case is not None:
+        cases.append(case)
+    if not cases:
+        raise ValueError('empty configuration list')
+    for case in cases:
+        missing = FIELDS - case['fields'].keys()
+        if missing:
+            raise ValueError(f"{case['name']}: missing fields: {', '.join(sorted(missing))}")
+    return cases
+
+
+def _quantity(text, units):
+    match = re.fullmatch(r'([0-9]+(?:\.[0-9]+)?)\s*(' + '|'.join(units) + r')', text)
+    if not match:
+        raise ValueError(f'unsupported quantity: {text}')
+    value = float(match.group(1)) * units[match.group(2)]
+    if not math.isfinite(value):
+        raise ValueError(f'quantity outside finite range: {text}')
+    return value
+
+
+def inventory(path=DEFAULT_LIST, *, noise_dbm_hz=-164.):
+    """Re-read bytes each call, retain duplicate rows and refuse malformed inputs."""
+    if not math.isfinite(noise_dbm_hz):
+        raise ValueError('finite noise density required')
+    raw = Path(path).read_bytes()
+    cases = parse_list(raw.decode('utf-8'))
+    for index, case in enumerate(cases, 1):
+        fields = case['fields']
+        data_w = _quantity(fields['Transmit Power'], {'mW': .001, 'W': 1., 'kW': 1000.})
+        helper_w = _quantity(fields['Helper Carrier Transmit Power'], {'mW': .001, 'W': 1., 'kW': 1000.})
+        loss = _quantity(fields['Path loss'], {'dB': 1.})
+        if data_w <= 0:
+            raise ValueError('DATA power must be positive')
+        # Native helper::Options default permits at most 90 dB helper/data.
+        effective_helper = min(helper_w, data_w * 1e9)
+        def cn0(watts):
+            return 10 * math.log10(watts * 1000) - loss - noise_dbm_hz
+        case.update(index=index, nominal_link_budget={
+            'noise_density_dbm_hz': noise_dbm_hz,
+            'triple_data_total_cn0_db_hz': cn0(data_w),
+            'helper_total_cn0_db_hz': cn0(effective_helper) if effective_helper else None,
+            'effective_helper_w': effective_helper,
+            'scope': 'Nominal total active power after listed path loss; no fading, filtering, or decoding success.'},
+            configuration_simulation={'status': 'not_implemented',
+                'cpu_seconds_per_received_second': None, 'dsp_workspace_margin': None,
+                'target_cn0_for_over_90_percent_success_db_hz': None,
+                'one_bit_transmit_seconds': None, 'fox_transmit_seconds': None,
+                'more_than_short_preparation_unavoidable': None})
+    return {'path': str(Path(path)), 'sha256': hashlib.sha256(raw).hexdigest(),
+            'case_count': len(cases), 'cases': cases,
+            'coverage': 'Inventory and nominal link budgets only; no listed configuration is simulated.'}
