+"""Deterministic inventory and nominal link-budget checks, not simulation."""
+import math
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+from triad_configurations import DEFAULT_LIST, inventory, parse_list
+
+CASE = '''- Case
+No\tEncryption
+40 W\tHelper Carrier Transmit Power
+4 W\tTransmit Power
+180 dB\tPath loss
+Several seconds\tClock sync / Region / Offset / Audio error
+Oscillator\tBase Oscillator
+Oscillator\tShift Oscillator
+Spread\tDoppler/delay spread
+Off\tAdditional frequency selective amplitude modulation
+1x\tMargin
+Off\tDSSS
+0x\tSpreading
+Off\tFHSS
+Off\tSymbol_burst
+1 Hz\tRate
+500 kHz\tShift
+'''
+
+
+class ConfigurationInventoryTests(unittest.TestCase):
+    def test_inventory_preserves_duplicates_and_nominal_budgets(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / 'cases.md'; path.write_text(CASE + '\n' + CASE)
+            result = inventory(path)
+        self.assertEqual(result['case_count'], 2)
+        self.assertEqual(result['cases'][0]['fields'], result['cases'][1]['fields'])
+        budget = result['cases'][0]['nominal_link_budget']
+        self.assertAlmostEqual(budget['triple_data_total_cn0_db_hz'], 10 * math.log10(4000) - 16)
+        self.assertAlmostEqual(budget['helper_total_cn0_db_hz'], 10 * math.log10(40000) - 16)
+        self.assertEqual(result['cases'][0]['configuration_simulation']['status'], 'not_implemented')
+
+    def test_reads_current_contents_every_time(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / 'cases.md'; path.write_text(CASE)
+            first = inventory(path)
+            path.write_text(CASE + '\n' + CASE.replace('40 W\tHelper', '0 W\tHelper'))
+            second = inventory(path)
+            self.assertEqual(second['case_count'], first['case_count'] + 1)
+            self.assertNotEqual(second['sha256'], first['sha256'])
+            self.assertIsNone(second['cases'][1]['nominal_link_budget']['helper_total_cn0_db_hz'])
+
+    def test_current_list_is_readable_without_freezing_its_contents(self):
+        expected = parse_list(DEFAULT_LIST.read_text())
+        current = inventory()
+        self.assertEqual(current['case_count'], len(expected))
+        self.assertEqual([case['fields'] for case in current['cases']],
+                         [case['fields'] for case in expected])
+
+    def test_missing_duplicate_unknown_or_unparseable_fields_fail_closed(self):
+        for bad in (CASE.replace('No\tEncryption', 'No\tUnknown', 1),
+                    CASE.replace('No\tEncryption', 'No\tEncryption\nNo\tEncryption', 1),
+                    CASE.replace('No\tEncryption\n', '', 1),
+                    CASE.replace('4 W\tTransmit Power', 'unsupported\tTransmit Power', 1)):
+            with self.subTest(bad=bad[:80]), self.assertRaises(ValueError):
+                with tempfile.TemporaryDirectory() as d:
+                    path = Path(d) / 'cases.md'; path.write_text(bad)
+                    inventory(path)
+
+
+if __name__ == '__main__':
+    unittest.main()
