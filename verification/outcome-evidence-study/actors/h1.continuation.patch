--- a/tools/triad_configuration_matrix.py
+++ b/tools/triad_configuration_matrix.py
@@ -6,6 +6,8 @@
 from __future__ import annotations
 
 import hashlib
+import math
+import re
 from pathlib import Path
 
 LIST_PATH = Path(__file__).resolve().parents[1] / '_tests-RobustModem.md'
@@ -53,3 +55,47 @@
     missing = FIELDS - case['fields'].keys()
     if missing:
         raise ValueError(f'line {number}: {case["name"]!r} missing fields: {sorted(missing)}')
+
+
+_POWER = re.compile(r"([0-9]+(?:\.[0-9]+)?)\s*(mW|W|kW)")
+_LOSS = re.compile(r"([0-9]+(?:\.[0-9]+)?)\s*dB")
+
+
+def nominal_link_budget(fields, *, noise_density_dbm_hz=-164.):
+    """Nominal active composite C/N0, not a simulation or sensitivity result.
+
+    The default matches triad-helper-export and GUI planning. The noise density
+    is absent from the case list, so retain it as an explicit assumption.
+    """
+    if not math.isfinite(noise_density_dbm_hz):
+        raise ValueError('noise density must be finite')
+    def watts(label):
+        match = _POWER.fullmatch(fields[label])
+        if match is None:
+            raise ValueError(f'unsupported {label}: {fields[label]!r}')
+        value = float(match.group(1))*{'mW': 1e-3, 'W': 1., 'kW': 1e3}[match.group(2)]
+        if not math.isfinite(value):
+            raise ValueError(f'nonfinite {label}')
+        return value
+    data = watts('Transmit Power')
+    helper = watts('Helper Carrier Transmit Power')
+    match = _LOSS.fullmatch(fields['Path loss'])
+    if data <= 0 or match is None:
+        raise ValueError('positive DATA power and a nonnegative dB path loss required')
+    loss = float(match.group(1))
+    if not math.isfinite(loss):
+        raise ValueError('path loss must be finite')
+    # Matches helper::Options default ratio_limit_db and the exporter's
+    # helper_options_for; Helper is a composite, not just its high pilot.
+    effective_helper = min(helper, data * 1e9)
+    def cn0(power):
+        return 10*math.log10(power)+30-loss-noise_density_dbm_hz
+    return {'assumed_noise_density_dbm_hz': noise_density_dbm_hz,
+            'data_power_w': data, 'requested_helper_power_w': helper,
+            'effective_helper_power_w': effective_helper, 'path_loss_db': loss,
+            'triple_data_cn0_db_hz': cn0(data),
+            'helper_composite_cn0_db_hz': cn0(effective_helper) if effective_helper > 0 else None,
+            'helper_status': 'present' if effective_helper > 0 else 'off',
+            'scope': ('Nominal active total three-carrier DATA and composite Helper powers; '
+                      'assumed flat noise, common path loss and 90 dB Helper/DATA cap. '
+                      'Not a measured post-fade value or a single Helper pilot.')}
