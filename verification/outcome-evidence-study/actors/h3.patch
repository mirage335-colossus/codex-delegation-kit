+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+from triad_configuration_inventory import LIST, inventory, parse
+
+FIXTURE = '''- example
+No\tEncryption
+0 W\tHelper Carrier Transmit Power
+1 mW\tTransmit Power
+200 dB\tPath loss
+broad\tClock sync / Region / Offset / Audio error
+base\tBase Oscillator
+shift\tShift Oscillator
+spread\tDoppler/delay spread
+Off\tAdditional frequency selective amplitude modulation
+1x\tMargin
+Off\tDSSS
+0x\tSpreading
+Off\tFHSS
+Off\tSymbol_burst
+0.1 Hz\tRate
+0 Hz\tShift
+'''
+
+
+class InventoryTest(unittest.TestCase):
+    def test_reads_current_list_in_order_including_duplicates(self):
+        report = inventory()
+        parsed = parse(LIST.read_text())
+        self.assertEqual([(c['name'], c['settings']) for c in report['cases']],
+                         [(c['name'], c['settings']) for c in parsed])
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'list.md'
+            path.write_text(FIXTURE + '\n' + FIXTURE)
+            cases = inventory(path)['cases']
+            self.assertEqual(len(cases), 2)
+            self.assertEqual(cases[0]['settings'], cases[1]['settings'])
+            self.assertAlmostEqual(cases[0]['nominal_total_data_cn0_db_hz'], -36)
+            self.assertIsNone(cases[0]['requested_helper_cn0_db_hz'])
+            self.assertIn('cpu_seconds_per_baseband_second', cases[0]['unavailable'])
+
+    def test_edits_are_used_and_invalid_edits_fail(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'list.md'
+            path.write_text(FIXTURE)
+            old = inventory(path)
+            path.write_text(FIXTURE.replace('1 mW\tTransmit Power', '2 mW\tTransmit Power'))
+            new = inventory(path)
+            self.assertNotEqual(old['list_sha256'], new['list_sha256'])
+            self.assertAlmostEqual(new['cases'][0]['nominal_total_data_cn0_db_hz'] - old['cases'][0]['nominal_total_data_cn0_db_hz'], 3.01029995664)
+            path.write_text(FIXTURE.replace('0.1 Hz\tRate', '0.1 Hz\tUnknown field'))
+            with self.assertRaises(ValueError):
+                inventory(path)
+            with self.assertRaises(ValueError):
+                parse(FIXTURE.replace('0.1 Hz\tRate\n', ''))
+
+
+if __name__ == '__main__':
+    unittest.main()
