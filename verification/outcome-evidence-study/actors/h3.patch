+#!/usr/bin/env python3
+"""Read the current manual Robust list and report its unresolved evidence needs.
+
+This inventory is a prerequisite for configuration-bound experiments, not a
+receiver simulation or a substitute for the abbreviated timing harness.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+LIST = ROOT / '_tests-RobustModem.md'
+FIELDS = frozenset(('Encryption', 'Helper Carrier Transmit Power', 'Transmit Power',
+    'Path loss', 'Clock sync / Region / Offset / Audio error', 'Base Oscillator',
+    'Shift Oscillator', 'Doppler/delay spread',
+    'Additional frequency selective amplitude modulation', 'Margin', 'DSSS',
+    'Spreading', 'FHSS', 'Symbol_burst', 'Rate', 'Shift'))
+
+
+def parse(text):
+    cases = []
+    current = None
+    for number, line in enumerate(text.splitlines(), 1):
+        if not line.strip():
+            continue
+        if line.startswith('- '):
+            if current is not None:
+                _finish(current)
+            current = {'name': line[2:].strip(), 'line': number, 'settings': {}}
+            if not current['name']:
+                raise ValueError(f'line {number}: empty case name')
+            cases.append(current)
+        else:
+            if current is None or '\t' not in line:
+                raise ValueError(f'line {number}: expected case or tab-separated setting')
+            value, key = (part.strip() for part in line.split('\t', 1))
+            if not value or key not in FIELDS or key in current['settings']:
+                raise ValueError(f'line {number}: empty, unknown or duplicate setting {key!r}')
+            current['settings'][key] = value
+    if current is None:
+        raise ValueError('empty configuration list')
+    _finish(current)
+    return cases
+
+
+def _finish(case):
+    missing = FIELDS - case['settings'].keys()
+    if missing:
+        raise ValueError(f"line {case['line']}: missing fields: {', '.join(sorted(missing))}")
+
+
+def _quantity(value, units):
+    m = re.fullmatch(r'([0-9]+(?:\.[0-9]+)?)\s*(' + '|'.join(units) + r')', value)
+    if not m:
+        raise ValueError(f'unsupported quantity: {value!r}')
+    return float(m[1]) * units[m[2]]
+
+
+def inventory(path=LIST):
+    data = path.read_bytes()
+    cases = parse(data.decode('utf-8'))
+    for case in cases:
+        s = case['settings']
+        data_w = _quantity(s['Transmit Power'], {'mW': .001, 'W': 1., 'kW': 1000.})
+        helper_w = _quantity(s['Helper Carrier Transmit Power'], {'mW': .001, 'W': 1., 'kW': 1000.})
+        loss_db = _quantity(s['Path loss'], {'dB': 1.})
+        if data_w <= 0:
+            raise ValueError(f"line {case['line']}: DATA power must be positive")
+        # Matches the exporter's nominal thermal reference, not field noise.
+        case['nominal_total_data_cn0_db_hz'] = 10*math.log10(data_w*1000)-loss_db+164
+        # Nominal requested Helper only: the production power limiter and gating
+        # must be resolved by the native exporter before asserting effective C/N0.
+        case['requested_helper_cn0_db_hz'] = (10*math.log10(helper_w*1000)-loss_db+164
+                                             if helper_w else None)
+        case['requested_helper_scope'] = 'requested power; excludes production power limiting and gating' if helper_w else 'off'
+        case['unavailable'] = {
+            'target_cn0_for_over_90_percent_success_db_hz': 'requires end-to-end correct-reception simulations',
+            'single_bit_transmit_seconds': 'requires source-bound duration selection and native calendar',
+            'fox_transmit_seconds': 'requires actual message framing and native calendar',
+            'receiver_preparation': 'requires selected receiver and preparation measurement',
+            'cpu_seconds_per_baseband_second': 'requires measured complete post-preparation receiver processing',
+            'cpu_ceiling_and_dsp_workspace_margin': 'requires selected complete receiver and explicit available budgets',
+        }
+    return {'schema': 'triad-configuration-inventory-v1',
+            'list_path': str(path), 'list_sha256': hashlib.sha256(data).hexdigest(),
+            'scope': 'Inventory and nominal power/noise-density arithmetic only; not a simulation or a test result. -164 dBm/Hz is the native exporter noise assumption.',
+            'cases': cases}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--list', type=Path, default=LIST)
+    args = parser.parse_args()
+    print(json.dumps(inventory(args.list), indent=2, allow_nan=False))
+
+
+if __name__ == '__main__':
+    main()
