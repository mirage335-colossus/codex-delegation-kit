+"""Brief, local post-preparation receive throughput and allocation benchmark."""
+import argparse
+import os
+import time
+import tracemalloc
+from receiver import load_cases, prepare_receiver, receive, synthesize
+
+
+def available_memory():
+    """Return Linux host available bytes if exposed, not a process allocation limit."""
+    try:
+        with open('/proc/meminfo', encoding='ascii') as f:
+            for line in f:
+                if line.startswith('MemAvailable:'):
+                    return int(line.split()[1]) * 1024
+    except OSError:
+        pass
+    return None
+
+
+def run(case, duration):
+    tracemalloc.start()
+    samples = synthesize(case)
+    plan = prepare_receiver(case['sample_rate'], len(samples),
+                            case['symbol_samples'], len(case['bits']))
+    retained, _ = tracemalloc.get_traced_memory()
+    tracemalloc.reset_peak()
+    receive(samples, plan)
+    _, peak = tracemalloc.get_traced_memory()
+    workspace = max(0, peak - retained)
+    tracemalloc.stop()  # Instrumentation must not distort timing.
+
+    iterations = 0
+    wall_start, cpu_start = time.perf_counter(), time.process_time()
+    while True:
+        result = receive(samples, plan)
+        iterations += 1
+        wall = time.perf_counter() - wall_start
+        if wall >= duration:
+            break
+    cpu = time.process_time() - cpu_start
+    input_seconds = iterations * len(samples) / case['sample_rate']
+    start, offset, bits = result
+    bit_errors = sum(a != b for a, b in zip(bits, case['bits'])) + abs(len(bits) - len(case['bits']))
+    print(f"{case['name']}: bits={bits}/{case['bits']} errors={bit_errors} "
+          f"start={start}/{case['leading_samples']} offset={offset}/{case['offset_hz']} Hz")
+    print(f'  {iterations} receives, {input_seconds:.3f} input s, '
+          f'{wall:.3f} wall s, {cpu:.3f} CPU s')
+    print(f'  wall processing/input={wall/input_seconds:.6f} s/s; '
+          f'real-time wall margin={input_seconds/wall:.1f}x')
+    print(f'  CPU processing/input={cpu/input_seconds:.6f} s/s; '
+          f'single-core CPU ceiling={input_seconds/cpu:.1f}x real time')
+    print(f'  traced retained input+plan={retained:,} B; '
+          f'additional peak receive workspace={workspace:,} B')
+    return retained, workspace
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--seconds', type=float, default=0.4,
+                        help='minimum wall seconds per case (default: 0.4)')
+    args = parser.parse_args()
+    if args.seconds <= 0:
+        parser.error('--seconds must be positive')
+    print(f'logical CPUs visible: {os.cpu_count()}; '
+          'one receive at a time; each observation includes leading/trailing noise')
+    available = available_memory()
+    if available is not None:
+        print(f'host MemAvailable snapshot: {available:,} B (not a process/container limit)')
+    cases = load_cases()
+    if not cases:
+        raise ValueError('case list is empty')
+    for case in cases:
+        retained, workspace = run(case, args.seconds)
+        if available is not None:
+            print(f'  host-available / traced input+plan+workspace: '
+                  f'{available / (retained + workspace):.0f}x (rough shared-memory comparison)')
+
+
+if __name__ == '__main__':
+    main()
