+@dataclass(frozen=True)
+class ReceiverPlan:
+    sample_count: int
+    symbol_samples: int
+    symbol_count: int
+    # Reusable, absolute-index quadrature references for each frequency pair.
+    references: tuple
+
+
+def prepare_receiver(sample_rate, sample_count, symbol_samples, symbol_count,
+                     offsets=range(-8, 9)):
+    """Prepare a bounded search; no signal, start time or bit values are used.
+
+    The defaults search integer-Hz common offsets from -8 through +8. The symbol
+    size/count and observation length are assumed known. Reuse only on streams
+    with identical geometry.
+    """
+    if sample_rate <= 0 or symbol_samples <= 0 or symbol_count <= 0:
+        raise ValueError('sample rate and symbol dimensions must be positive')
+    if sample_count < symbol_samples * symbol_count:
+        raise ValueError('observation is shorter than the message')
+    references = []
+    for offset in offsets:
+        pair = []
+        for tone in TONES:
+            if not 0 < tone + offset < sample_rate / 2:
+                raise ValueError('search frequencies must lie below Nyquist')
+            angles = (2 * math.pi * (tone + offset) * i / sample_rate
+                      for i in range(sample_count))
+            cosines, sines = array('d'), array('d')
+            for angle in angles:
+                cosines.append(math.cos(angle))
+                sines.append(math.sin(angle))
+            pair.append((cosines, sines))
+        references.append((offset, tuple(pair)))
+    if not references:
+        raise ValueError('at least one frequency offset is required')
+    return ReceiverPlan(sample_count, symbol_samples, symbol_count, tuple(references))
+
+
+def receive(samples, plan):
+    """Search all feasible integer starts and prepared offsets, then decide bits.
+
+    Maximize summed per-symbol tone energy. Results are an estimate, not a
+    confidence score or proof that a signal is present.
+    """
+    if len(samples) != plan.sample_count:
+        raise ValueError('stream length differs from the prepared geometry')
+    n, count = plan.symbol_samples, plan.symbol_count
+    best_score, best = -1.0, None
+    for offset, pair in plan.references:
+        prefixes = []
+        for cosines, sines in pair:
+            real, imag = array('d', [0.0]), array('d', [0.0])
+            r = i = 0.0
+            for x, c, s in zip(samples, cosines, sines):
+                r += x * c
+                i += x * s
+                real.append(r)
+                imag.append(i)
+            prefixes.append((real, imag))
+        for start in range(len(samples) - n * count + 1):
+            score = 0.0
+            decisions = []
+            for k in range(count):
+                begin = start + k * n
+                end = begin + n
+                energies = []
+                for real, imag in prefixes:
+                    re = real[end] - real[begin]
+                    im = imag[end] - imag[begin]
+                    energies.append(re * re + im * im)
+                decisions.append(int(energies[1] > energies[0]))
+                score += max(energies)
+            if score > best_score:
+                best_score = score
+                best = (start, offset, ''.join(map(str, decisions)))
+    return best
+
+
