+"""Fail-closed coverage of the manually edited configuration list."""
+from pathlib import Path
+import tempfile
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+from triad_configuration_matrix import FIELDS, read_configurations
+import triad_abbreviated
+
+
+def case(name='one'):
+    return '- ' + name + '\n' + ''.join('example\t' + field + '\n' for field in sorted(FIELDS))
+
+
+class ConfigurationMatrixTests(unittest.TestCase):
+    def test_reads_edits_and_keeps_duplicate_cases(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'cases.md'
+            path.write_text(case())
+            first = read_configurations(path)
+            path.write_text(case() + '\n' + case())
+            second = read_configurations(path)
+            self.assertNotEqual(first['sha256'], second['sha256'])
+            self.assertEqual([c['name'] for c in second['cases']], ['one', 'one'])
+            self.assertEqual(second['cases'][0]['fields'], second['cases'][1]['fields'])
+
+    def test_suite_reads_current_list_each_run(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'cases.md'
+            path.write_text(case())
+            with patch.object(triad_abbreviated, 'read_configurations', side_effect=lambda: read_configurations(path)), \
+                 patch.object(triad_abbreviated, 'source_identity', return_value={}), \
+                 patch.object(triad_abbreviated, 'kernels', return_value=({}, {})), \
+                 patch.object(triad_abbreviated, '_measure', side_effect=lambda *args: args[-1]):
+                first = triad_abbreviated.run()
+                path.write_text(case() + case('two'))
+                second = triad_abbreviated.run()
+            self.assertEqual(len(first['cases']), 1)
+            self.assertEqual(len(second['cases']), 2)
+            self.assertNotEqual(first['sha256'], second['sha256'])
+
+    def test_changed_list_during_measurement_is_rejected(self):
+        original = {'sha256': 'before', 'cases': []}
+        calls = {name: lambda: None for name in triad_abbreviated.KERNELS}
+        with patch.object(triad_abbreviated, 'read_configurations', return_value={'sha256': 'after', 'cases': []}), \
+             patch.object(triad_abbreviated, 'source_identity', return_value={}), \
+             patch.object(triad_abbreviated, 'environment', return_value={}), \
+             patch.object(triad_abbreviated, 'analyze', return_value={'stop': True, 'comparison': 'uncompared'}):
+            with self.assertRaisesRegex(RuntimeError, 'configuration list changed'):
+                triad_abbreviated._measure(calls, {}, {}, 0, 1000, 'cpu', None, original)
+
+    def test_rejects_missing_unknown_and_duplicate_fields(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'cases.md'
+            for text in ('', case().replace('example\tRate\n', ''),
+                         case() + 'example\tunknown\n', case() + 'example\tRate\n'):
+                with self.subTest(text=text), self.assertRaises(ValueError):
+                    path.write_text(text)
+                    read_configurations(path)
+
+    def test_current_list_is_valid(self):
+        result = read_configurations()
+        self.assertTrue(result['cases'])
+        self.assertEqual(len(result['sha256']), 64)
+
+
+if __name__ == '__main__':
+    unittest.main()
