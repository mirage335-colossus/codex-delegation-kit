@@ -0,0 +1,55 @@
+"""Read the manually maintained Robust exercise list without caching it.
+
+The values remain literal until a validated adapter can map every field to the
+native simulator and receiver. In particular, unknown labels must never vanish.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+LIST_PATH = Path(__file__).resolve().parents[1] / '_tests-RobustModem.md'
+FIELDS = frozenset({
+    'Encryption', 'Helper Carrier Transmit Power', 'Transmit Power', 'Path loss',
+    'Clock sync / Region / Offset / Audio error', 'Base Oscillator',
+    'Shift Oscillator', 'Doppler/delay spread',
+    'Additional frequency selective amplitude modulation', 'Margin', 'DSSS',
+    'Spreading', 'FHSS', 'Symbol_burst', 'Rate', 'Shift',
+})
+
+
+def read_configurations(path=LIST_PATH):
+    """Return all rows in order, including duplicates; reject incomplete edits."""
+    raw = Path(path).read_bytes()
+    text = raw.decode('utf-8')
+    cases = []
+    current = None
+    for number, line in enumerate(text.splitlines(), 1):
+        line = line.strip()
+        if not line:
+            continue
+        if line.startswith('- '):
+            if current is not None:
+                _finish(current, number)
+            name = line[2:].strip()
+            if not name:
+                raise ValueError(f'line {number}: empty configuration name')
+            current = {'name': name, 'fields': {}}
+            cases.append(current)
+            continue
+        if current is None or '\t' not in line:
+            raise ValueError(f'line {number}: expected case heading or tab-separated value and label')
+        value, label = (part.strip() for part in line.split('\t', 1))
+        if not value or label not in FIELDS or label in current['fields']:
+            raise ValueError(f'line {number}: empty value, unknown or duplicate field {label!r}')
+        current['fields'][label] = value
+    if current is None:
+        raise ValueError('configuration list is empty')
+    _finish(current, number + 1)
+    return {'sha256': hashlib.sha256(raw).hexdigest(), 'cases': cases}
+
+
+def _finish(case, number):
+    missing = FIELDS - case['fields'].keys()
+    if missing:
+        raise ValueError(f'line {number}: {case["name"]!r} missing fields: {sorted(missing)}')
