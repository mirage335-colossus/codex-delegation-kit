+    auto& alternative=contrast["quarter_power_slots"].array();
+    std::array<ReceiverSlotScore,3> baseline;
+    const auto input=[&](const auto& slot) {
+        return capture.subspan(slot.first_sample-quarter_power_first_sample,slot.stop_sample-slot.first_sample);
+    };
+    const auto receipt=[&](const ReceiverSlotScore& score,const ReceiverSlotPlan& slot,double seconds) {
+        require(score.complete&&score.all_valid&&score.zero_h0_verified&&score.consumed_samples==input(slot).size()&&
+            score.noise_statistics_valid,"quarter-power comparison did not score a complete valid aperture with its null");
