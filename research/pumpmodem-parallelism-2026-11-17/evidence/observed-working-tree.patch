+
+receiver_detail::SlotEvidenceSupplement quarter_power_supplement(Json& evidence) {
+    receiver_detail::SlotEvidenceSupplement supplement;
+    supplement.fixed_weight=quarter_power_weight;
+    supplement.supported=[](const auto&,const auto&){return true;};
+    supplement.workspace=quarter_power_affine_workspace;
+    supplement.score=[&evidence](const auto& config,const auto& slot,const auto& key,auto iq,const auto& fine,
+                            unsigned workers,std::size_t workspace,std::stop_token stop,auto& executor) {
+        auto scaled=config;
+        scaled.data_basis_gain*=.5;
+        const auto geometry=receiver_detail::coarse_fine_geometry(config,slot);
+        ReceiverSlotScore score;
+        const auto started=Clock::now();
+        receiver_detail::score_fine(scaled,slot,key,iq,fine.coordinates,geometry.projected_sample_rate_hz,
+            geometry.clock_gap_ppm,workers,score,workspace,stop,&executor);
+        require(score.complete&&score.all_valid&&score.zero_h0_verified&&score.consumed_samples==iq.size()&&
+            score.fine_candidates==fine.coordinates.size()&&score.fine_candidates>0,
+            "quarter-power affine component did not score the complete selected public bank");
+        const auto log_mass=std::log(static_cast<double>(score.fine_candidates))-fine.grid.log_count();
+        const std::array charged{score.bit_evidence[0]+log_mass,score.bit_evidence[1]+log_mass};
+        evidence=object({{"raw_affine_bit_log_evidence",Json::Array{score.bit_evidence[0],score.bit_evidence[1]}},
+            {"public_prior_adjusted_bit_log_evidence",Json::Array{charged[0],charged[1]}},{"selected_prior_mass",std::exp(log_mass)},
+            {"fine_candidates",score.fine_candidates},{"basis_rows",score.basis_rows},
+            {"workspace_bytes",workspace},{"wall_seconds",std::chrono::duration<double>(Clock::now()-started).count()}});
+        return charged;
+    };
+    return supplement;
+}
