+std::array<ReceiverSlotPlan,3> quarter_power_slots(const Setup& s) {
+    require(s.horizon==retained_two_hop_samples&&s.slot_horizon==15&&s.q0==13&&
+        s.truth.size()==13&&s.truth.back()==1&&s.resources.workers==24&&
+        s.receiver.sample_rate_hz==1920.&&s.receiver.time_varying_channel&&
+        s.receiver.spread_delay_seconds==0.&&s.receiver.spread_doppler_hz==0.&&
+        s.receiver.clock_bound_ppm==0.&&s.receiver.frequency_bound_hz==0.&&
+        s.receiver.time_varying_atmospheric_hz==5.&&s.receiver.time_varying_common_doppler_hz==5.&&
+        s.receiver.random_doppler_width_hz==0.&&std::abs(s.receiver.noise_variance-962.2794885643629)<1e-9&&
+        !s.receiver.helper_enabled&&!s.native_channel&&!s.native_chain,
+        "quarter-power comparison differs from the frozen one-template receiver geometry");
+    const std::array slots{
+        make_receiver_slot_plan(s.profile,s.receiver,quarter_power_first_slot),
+        make_receiver_slot_plan(s.profile,s.receiver,quarter_power_first_slot+1),
+        make_receiver_slot_plan(s.profile,s.receiver,quarter_power_first_slot+2)};
+    constexpr std::array<std::uint64_t,3> first{quarter_power_first_sample,3'743'875,4'031'874};
+    constexpr std::array<std::uint64_t,3> stop{3'724'572,4'012'572,retained_two_hop_samples};
+    for(std::size_t i=0;i<slots.size();++i)
+        require(slots[i].first_sample==first[i]&&slots[i].stop_sample==stop[i]&&
+            slots[i].index==quarter_power_first_slot+i&&slots[i].format.symbol_ordinal==quarter_power_first_slot+i&&
+            slots[i].format.epoch==1'793'406'600+150*i,
+            "quarter-power comparison did not preserve the frozen public calendar");
+    return slots;
+}
