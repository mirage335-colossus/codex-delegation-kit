+        row["likelihood_components"]=slot_likelihood_components(score);
+        row["zero_h0_verified"]=score.zero_h0_verified;
+        row["consumed_samples"]=score.consumed_samples;
+        row["expected_bit"]=slot.index==quarter_power_first_slot?Json(1):Json{};
+        row["score_seconds_including_executor_lifetime"]=seconds;
+        return row;
+    };
+    for(std::size_t i=0;i<slots.size();++i) {
+        const auto& slot=slots[i];
+        deadline.check();
+        const auto began=Clock::now();
+        baseline[i]=score_receiver_slot(s.receiver,slot,s.key,input(slot),{},workers,available,deadline.stop.get_token());
+        ordinary.push_back(receipt(baseline[i],slot,std::chrono::duration<double>(Clock::now()-began).count()));
+    }
+    constexpr std::array ordinary_log_e{16.603733824027834,-6.858888618805563,-6.775606921505348};
+    for(std::size_t i=0;i<slots.size();++i)
+        require(baseline[i].decision==SlotDecision::quiet&&baseline[i].fine_candidates==4&&
+            std::abs(baseline[i].operational_log_e-ordinary_log_e[i])<=1e-6,
+            "current ordinary scorer did not reproduce the frozen +3 dB-Hz aperture outcome");
+    contrast["ordinary_archive_gate_passed"]=true;
+    std::cerr<<"two-hop +3 dB-Hz ordinary apertures matched the archived native scores\n"<<std::flush;
+
+    // Preserve only the decisive all-valid tail for a possible follow-up.
+    // This exclusive caller-owned file is never used to select geometry.
+    Hash tail_hash;
+    std::ranges::fill(valid,1);
+    for(std::size_t at=0;at<capture.size();at+=staging.size()) {
+        deadline.check();
+        const auto rows=capture.subspan(at,std::min(staging.size(),capture.size()-at));
+        tail.append(rows,valid.first(rows.size()));
+        tail_hash.samples(rows,valid.first(rows.size()));
+    }
+    tail.seal();tail.rewind();
+    Hash readback;
+    for(std::size_t at=0;at<capture.size();at+=staging.size()) {
+        deadline.check();
+        const auto rows=staging.first(std::min(staging.size(),capture.size()-at));
+        tail.read(rows,valid.first(rows.size()));
+        readback.samples(rows,valid.first(rows.size()));
+    }
+    const auto digest=tail_hash.finish();
+    require(readback.finish()==digest,"quarter-power retained tail differs from the captured samples");
+    contrast["retained_capture"]=object({{"path",o.two_hop_quarter_power_capture},
+        {"samples",tail.rows()},{"bytes",tail.bytes()},{"sha256",digest},{"readback_verified",true},
+        {"resident_backing_reservation_bytes",tail.resident_reservation_bytes()}});
+    for(std::size_t i=0;i<slots.size();++i) {
+        const auto& slot=slots[i];
+        deadline.check();
+        const auto began=Clock::now();
+        Json affine;
+        const auto supplement=quarter_power_supplement(affine);
+        const auto score=receiver_detail::score_slot_with_supplement(s.receiver,slot,s.key,input(slot),{},workers,
+            available,deadline.stop.get_token(),nullptr,supplement);
+        require(score.fine_candidates==baseline[i].fine_candidates&&score.selected_prior_mass==baseline[i].selected_prior_mass&&
+            score.bit_evidence==baseline[i].bit_evidence&&score.basis_rows==baseline[i].basis_rows,
+            "quarter-power alternative changed the ordinary fixed-affine preparation or evidence");
+        auto row=receipt(score,slot,std::chrono::duration<double>(Clock::now()-began).count());
+        row["quarter_power_affine"]=std::move(affine);
+        alternative.push_back(std::move(row));
+    }
